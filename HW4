


  // ----------------------------------------------------------
  // The actual signals — these are the wires
  // ----------------------------------------------------------
  logic        write;
  logic        read;
  logic [7:0]  data_in;
  logic [15:0] address;
  logic [8:0]  data_out;

  // ----------------------------------------------------------
  // Modport for the DUT
  // The DUT sees raw signals — NO clocking block here
  // clk is passed directly to the DUT from top
  // ----------------------------------------------------------
  modport dut_mp (
    input  write,
    input  read,
    input  data_in,
    input  address,
    output data_out
  );

  // ----------------------------------------------------------
  // Clocking Block — for the testbench ONLY
  // Synchronized to posedge clk (DUT is positive-edge triggered)
  //
  // #1step input skew  = sample inputs just before clock edge
  //                      (avoids race conditions reading DUT output)
  // default output skew = drive outputs after the clock edge
  //
  // The testbench drives/observes ALL signals through this block
  // ----------------------------------------------------------
  clocking cb @(posedge clk);
    default input #1step output #1;
    output write;
    output read;
    output data_in;
    output address;
    input  data_out;
  endclocking : cb

  // ----------------------------------------------------------
  // Checker — runs as a concurrent assertion
  // Fires whenever both read and write are 1 at the same time
  // This is an illegal memory transaction
  // ----------------------------------------------------------
  // Using a property + assert for clean structure
  property no_simultaneous_rw;
    @(posedge clk) not (read && write);
  endproperty

  assert property (no_simultaneous_rw)
    else $error("[%0t] CHECKER ERROR: read and write both asserted!", $time);

endinterface : mem_if
